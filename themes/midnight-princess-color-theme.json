    "editorSuggestWidget.selectedBackground": "#5b8fd955",
    "widget.border": "#212e45",
    "textCodeBlock.background": "#172235",
    "toolbar.hoverBackground": "#212e45",
    "foreground": "#b4bfd3",
    "descriptionForeground": "#8794b3",
    "icon.foreground": "#94a1ba",
    "sideBar.foreground": "#a3afc6",
    "sideBar.border": "#0b111d",
    "sideBarTitle.foreground": "#94a1ba",
    "sideBarSectionHeader.background": "#0b111d",
    "sideBarSectionHeader.foreground": "#94a1ba",
    "sideBarSectionHeader.border": "#172235",
