    "modernEditorTab.hoverForeground": "#d6e0f0",
    "modernTab.activeBackground": "#4f7fd033",
    "modernTab.activeForeground": "#f5b5c4",
    "modernTab.hoverBackground": "#1b2443",
    "modernTab.hoverForeground": "#d6e0f0",
    "modernPanel.border": "#1b2443",
    "modernUI.shellBackground": "#0e1428",
    "terminalCursor.foreground": "#f5b5c4",
    "terminal.selectionBackground": "#4f7fd055",
    "terminal.findMatchBackground": "#f5b5c455",
    "terminal.ansiBlack": "#263257",
    "terminal.ansiRed": "#ef8a9c",
    "terminal.ansiGreen": "#8fcfb0",
    "terminal.ansiYellow": "#f2d9a0",
    "terminal.ansiBlue": "#7ea6f2",
    "terminal.ansiMagenta": "#c3b5f0",
    "terminal.ansiCyan": "#a9cdf0",
    "terminal.ansiWhite": "#d6e0f0",
    "terminal.ansiBrightBlack": "#6f7fa6",
    "terminal.ansiBrightRed": "#f7b3c0",
    "terminal.ansiBrightGreen": "#b2e0c9",
    "terminal.ansiBrightYellow": "#f7e6bd",
    "terminal.ansiBrightBlue": "#a9c4f7",
    "terminal.ansiBrightMagenta": "#d8cdf7",
    "terminal.ansiBrightCyan": "#cfe3f7",
    "terminal.ansiBrightWhite": "#f3eee6",
    "gitDecoration.modifiedResourceForeground": "#f5b5c4",
    "gitDecoration.stageModifiedResourceForeground": "#f5b5c4",
    "gitDecoration.untrackedResourceForeground": "#a9cdf0",
    "gitDecoration.addedResourceForeground": "#a9cdf0",
    "gitDecoration.renamedResourceForeground": "#a9cdf0",
    "gitDecoration.deletedResourceForeground": "#ef8a9c",
    "gitDecoration.stageDeletedResourceForeground": "#ef8a9c",
    "gitDecoration.conflictingResourceForeground": "#f5b5c4",
    "gitDecoration.ignoredResourceForeground": "#46557e",
    "gitDecoration.submoduleResourceForeground": "#9eabc8",
    "editorGutter.modifiedBackground": "#f5b5c4",
    "editorGutter.addedBackground": "#a9cdf0",
    "editorGutter.deletedBackground": "#ef8a9c"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6f7fa6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7ea6f2"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#7ea6f2"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#7ea6f2"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#7ea6f2"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#a9cdf0"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a9cdf0"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a9cdf0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f5b5c4"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f3e9dc"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f3e9dc"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#c3b5f0"
      }
    },
    {
      "name": "Property access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#f5b5c4"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#a9cdf0",
    "method": "#a9cdf0",
    "class": "#f3e9dc",
    "type": "#f3e9dc",
    "interface": "#f3e9dc",
    "typeParameter": "#f3e9dc",
    "enum": "#f3e9dc",
    "enumMember": "#c3b5f0",
    "property.declaration": "#f5b5c4",
    "parameter": {
      "italic": true
    },
    "property": "#f5b5c4"
  }
}
