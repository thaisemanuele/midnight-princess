    "statusBar.foreground": "#9eabc8",
    "panelTitle.activeForeground": "#f5b5c4",
    "panelTitle.inactiveForeground": "#6f7fa6",
    "panelTitle.activeBorder": "#4f7fd0",
    "terminal.foreground": "#d6e0f0",
    "activityBarTop.foreground": "#f5b5c4",
    "activityBarTop.inactiveForeground": "#9eabc8",
