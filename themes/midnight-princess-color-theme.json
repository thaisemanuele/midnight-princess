    "editorSuggestWidget.selectedBackground": "#4f7fd055",
    "widget.border": "#263257",
    "textCodeBlock.background": "#1b2443",
    "toolbar.hoverBackground": "#263257",
    "foreground": "#c2cde3",
    "descriptionForeground": "#8391b4",
    "icon.foreground": "#9eabc8",
    "sideBar.foreground": "#aab6d0",
    "sideBar.border": "#0e1428",
    "sideBarTitle.foreground": "#9eabc8",
    "sideBarSectionHeader.background": "#0e1428",
    "sideBarSectionHeader.foreground": "#9eabc8",
    "sideBarSectionHeader.border": "#1b2443",
