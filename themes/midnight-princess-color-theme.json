    "tree.indentGuidesStroke": "#212e45",
    "activityBar.inactiveForeground": "#94a1ba",
    "tab.activeForeground": "#c8d3e6",
    "tab.inactiveForeground": "#7182a6",
    "tab.border": "#0b111d",
    "titleBar.activeForeground": "#94a1ba",
    "statusBar.foreground": "#94a1ba",
    "panelTitle.activeForeground": "#f0a8b8",
    "panelTitle.inactiveForeground": "#7182a6",
    "panelTitle.activeBorder": "#5b8fd9",
    "terminal.foreground": "#c8d3e6",
    "activityBarTop.foreground": "#f0a8b8",
    "activityBarTop.inactiveForeground": "#94a1ba",
    "activityBarTop.activeBorder": "#5b8fd9",
    "modernActivityBarItem.activeForeground": "#f0a8b8",
    "modernActivityBarItem.activeBackground": "#5b8fd933",
    "modernActivityBarItem.hoverForeground": "#c8d3e6",
    "modernActivityBarItem.hoverBackground": "#172235",
    "modernActivityBar.border": "#172235",
    "modernEditorTab.activeBackground": "#101827",
    "modernEditorTab.activeForeground": "#c8d3e6",
    "modernEditorTab.inactiveBackground": "#0b111d",
    "modernEditorTab.hoverBackground": "#172235",
    "modernEditorTab.hoverForeground": "#c8d3e6",
    "modernTab.activeBackground": "#5b8fd933",
    "modernTab.activeForeground": "#f0a8b8",
    "modernTab.hoverBackground": "#172235",
    "modernTab.hoverForeground": "#c8d3e6",
    "modernPanel.border": "#172235",
    "modernUI.shellBackground": "#0b111d",
    "terminalCursor.foreground": "#f0a8b8",
    "terminal.selectionBackground": "#5b8fd955",
    "terminal.findMatchBackground": "#f0a8b855",
    "terminal.ansiBlack": "#212e45",
    "terminal.ansiRed": "#f0a8b8",
    "terminal.ansiGreen": "#a8d8f0",
    "terminal.ansiYellow": "#e8e5e1",
    "terminal.ansiBlue": "#5b8fd9",
    "terminal.ansiMagenta": "#e58fa5",
    "terminal.ansiCyan": "#8fc3e6",
    "terminal.ansiWhite": "#c8d3e6",
    "terminal.ansiBrightBlack": "#7182a6",
    "terminal.ansiBrightRed": "#f7c6d1",
    "terminal.ansiBrightGreen": "#c9e8f7",
    "terminal.ansiBrightYellow": "#f4f2ef",
    "terminal.ansiBrightBlue": "#85acec",
    "terminal.ansiBrightMagenta": "#f0a8b8",
    "terminal.ansiBrightCyan": "#b9e0f4",
    "terminal.ansiBrightWhite": "#f4f2ef",
    "gitDecoration.modifiedResourceForeground": "#f0a8b8",
    "gitDecoration.stageModifiedResourceForeground": "#f0a8b8",
    "gitDecoration.untrackedResourceForeground": "#a8d8f0",
    "gitDecoration.addedResourceForeground": "#a8d8f0",
    "gitDecoration.renamedResourceForeground": "#a8d8f0",
    "gitDecoration.deletedResourceForeground": "#e58fa5",
    "gitDecoration.stageDeletedResourceForeground": "#e58fa5",
    "gitDecoration.conflictingResourceForeground": "#f0a8b8",
    "gitDecoration.ignoredResourceForeground": "#3f4f6b",
    "gitDecoration.submoduleResourceForeground": "#94a1ba",
    "editorGutter.modifiedBackground": "#f0a8b8",
    "editorGutter.addedBackground": "#a8d8f0",
    "editorGutter.deletedBackground": "#e58fa5"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7182a6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5b8fd9"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#5b8fd9"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#5b8fd9"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#5b8fd9"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#a8d8f0"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a8d8f0"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a8d8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f0a8b8"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e8e5e1"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#e8e5e1"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#a8d8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#f0a8b8"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#a8d8f0",
    "method": "#a8d8f0",
    "class": "#e8e5e1",
    "type": "#e8e5e1",
    "interface": "#e8e5e1",
    "typeParameter": "#e8e5e1",
    "enum": "#e8e5e1",
    "enumMember": "#a8d8f0",
    "property.declaration": "#f0a8b8",
    "parameter": {
      "italic": true
    },
    "property": "#f0a8b8"
  }
}
