    "editor.wordHighlightBackground": "#7ed3ff1f",
    "editor.selectionHighlightBackground": "#7ed3ff1f",
    "textLink.foreground": "#7ed3ff",
    "textLink.activeForeground": "#b3e6ff"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f7aa0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#4f8fef"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#4f8fef"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#4f8fef"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#4f8fef"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#a8d8f0"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a8d8f0"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a8d8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7ed3ff"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#a8d8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f9e6b2"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f4c76a",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#a8d8f0",
    "method": "#a8d8f0",
    "class": {
      "foreground": "#a8d8f0",
      "italic": true
    },
    "type": {
      "foreground": "#a8d8f0",
      "italic": true
    },
    "interface": {
      "foreground": "#a8d8f0",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#a8d8f0",
      "italic": true
    },
    "enum": {
      "foreground": "#a8d8f0",
      "italic": true
    },
    "enumMember": {
      "foreground": "#f4c76a",
      "italic": true
    },
    "property.declaration": "#e8f6ff",
    "parameter": {
      "italic": true
    },
    "property": "#e8f6ff"
  }
}
